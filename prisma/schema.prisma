generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////
// ENUMS
//////////////////////

enum UserRole {
  ADMIN
  STAFF
}

enum PaymentMode {
  CASH
  ONLINE
  CARD
  SPLIT
  CREDIT
}
enum PurchaseStatus {
  PENDING
  COMPLETED
  CANCELLED
}

//////////////////////
// MODELS
//////////////////////
model Organization {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String?
  createdAt DateTime @default(now())

  // Relations
  users      User[]
  categories Category[]
  products   Product[]
  sales      Sale[]

  suppliers    Supplier[]
  purchases    Purchase[]
}

model User {
  id           String       @id @default(uuid())
  orgId        String // <--- The Scope
  organization Organization @relation(fields: [orgId], references: [id])
  name         String
  email        String       @unique
  password     String
  role         UserRole     @default(STAFF)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  fcmToken     String?
  

  sales Sale[]
  purchases    Purchase[]
}
model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  orgId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1. Unique constraint for data integrity
  @@unique([phone, orgId]) 

  // 2. Composite index for organization-specific lookups
  // This speeds up: SELECT * FROM Customer WHERE orgId = 'xyz' AND name LIKE 'abc%'
  @@index([orgId, name])
  
  // 3. Phone lookup index
  // This speeds up: SELECT * FROM Customer WHERE orgId = 'xyz' AND phone = '12345'
  @@index([orgId, phone])
}
model Category {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])

  name     String
  products Product[]

  // A category name only needs to be unique WITHIN a store
  @@unique([orgId, name])
}

model Product {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])

  name      String
  price     Decimal  @db.Decimal(10, 2)
  costPrice Decimal? @db.Decimal(10, 2)
  barcode   String
  qrCode    String?
  stockQty  Float    @default(0)
  minStock  Float    @default(5)
  unit      String   @default("PCS")

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleItems SaleItem[]
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  purchaseItems PurchaseItem[]
  @@unique([id, orgId])
  @@unique([orgId, barcode])
  @@index([orgId])
  @@index([barcode])
  @@index([name])
}

model Sale {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])

  billNumber String
  userId     String
  user       User   @relation(fields: [userId], references: [id])

  totalAmount Decimal @db.Decimal(10, 2)
  taxAmount   Float   @default(0)
  gstPercentage Float    @default(0)

  discount    Float   @default(0)
  finalAmount Decimal @db.Decimal(10, 2)
  amountCash    Decimal      @default(0) @db.Decimal(10, 2)
  amountOnline  Decimal      @default(0) @db.Decimal(10, 2) // UPI
  amountCard    Decimal      @default(0) @db.Decimal(10, 2)
  
  // Optional: For CREDIT/Khata sales
  amountDue     Decimal      @default(0) @db.Decimal(10, 2)

  paymentMode PaymentMode
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  items SaleItem[]

  // Bill number is unique per store
  @@unique([orgId, billNumber])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Float
  price     Decimal @db.Decimal(10, 2)
  lineDiscount Float   @default(0) // New field
  taxRate      Float   @default(0) // New field

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Purchase {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])

  supplierId   String
  supplier     Supplier     @relation(fields: [supplierId], references: [id])

  userId       String
  user         User         @relation(fields: [userId], references: [id])

  invoiceNo    String?      // Supplier's bill/invoice number
  
  totalAmount  Decimal      @db.Decimal(10, 2)
  taxAmount    Float        @default(0)
  discount     Float        @default(0)
  finalAmount  Decimal      @db.Decimal(10, 2)
  
  amountPaid   Decimal      @default(0) @db.Decimal(10, 2)
  amountDue    Decimal      @default(0) @db.Decimal(10, 2)
  paymentMode  PaymentMode?

  status       PurchaseStatus @default(COMPLETED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  items        PurchaseItem[]

  // Ensure a supplier's invoice isn't entered twice in the same store
  @@unique([orgId, supplierId, invoiceNo])
  @@index([orgId])
}

model PurchaseItem {
  id           String   @id @default(uuid())
  purchaseId   String
  purchase     Purchase @relation(fields: [purchaseId], references: [id])

  productId    String
  product      Product  @relation(fields: [productId], references: [id])

  quantity     Float
  costPrice    Decimal  @db.Decimal(10, 2)
  taxRate      Float    @default(0)

  @@index([purchaseId])
  @@index([productId])
}
model Supplier {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])

  name         String
  contactName  String?
  phone        String?
  email        String?
  address      String?
  gstNumber    String?      // Useful for tax purposes
  
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  products     Product[]
  purchases    Purchase[]

  // A supplier name should be unique within a single store
  @@unique([orgId, name])
  @@index([orgId, name])
  @@index([orgId, phone])
}